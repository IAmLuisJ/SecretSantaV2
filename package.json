    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/workers-types": "5.20261107.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cf": "1.0.0-beta.12",
    "miniflare": "5.20261104.0-beta",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
